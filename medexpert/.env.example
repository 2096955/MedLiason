# MedExpert — Environment Variables
# Copy to .env and fill in values

# ── Solace Broker ──────────────────────────────────────────────
SOLACE_DEV_MODE=true
SOLACE_BROKER_URL=ws://localhost:8008
SOLACE_BROKER_USERNAME=default
SOLACE_BROKER_PASSWORD=default
SOLACE_BROKER_VPN=default
USE_TEMPORARY_QUEUES=true
NAMESPACE=medexpert

# ── Gateway ───────────────────────────────────────────────────
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
SESSION_SECRET_KEY=change-me-in-production

# ── LLM (via LiteLLM) ────────────────────────────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── NCBI / PubMed (optional, raises rate limit from 3 to 10 req/s)
# NCBI_API_KEY=

# ── Census API (free key from api.census.gov) ─────────────────
# CENSUS_API_KEY=

# ── EPA AQS (free key from aqs.epa.gov) ──────────────────────
# EPA_AQS_EMAIL=
# EPA_AQS_KEY=

# ── Redis (memory plane) ─────────────────────────────────────
# SECURITY: For production deployments handling PHI/medical data,
# use authenticated Redis: redis://:YOUR_PASSWORD@localhost:6379/0
# Set MEDEXPERT_ENV=development to suppress the auth warning in dev.
REDIS_URL=redis://localhost:6379/0

# ── Memgraph (knowledge graph, optional) ─────────────────────
# Requires Memgraph running locally or as Cloud Run sidecar.
# Install: docker run -d -p 7687:7687 memgraph/memgraph:latest
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=medexpert-demo
# MEMGRAPH_RO_USER=memgraph        # Read-only user (fallback to MEMGRAPH_USER)
# MEMGRAPH_RO_PASSWORD=medexpert-demo

# ── Firecrawl (NHS 111 + BMA Library scraping) ──────────────
# FIRECRAWL_API_KEY=fc-2146c607264b4ea899e16c2a7bc951ec

# ── OpenEvidence (session cookies) ─────────────────────────
# Run `npm run login` in the openevidence-mcp repo to generate storage-state.json
# OE_AUTH_STATE_PATH=~/.openevidence-mcp/auth/storage-state.json

# ── Speech (STT / TTS) ─────────────────────────────────────
# TTS: Gemini via Vertex AI ADC — uses GOOGLE_APPLICATION_CREDENTIALS
#      service account (no separate key needed).
# STT: Browser Web Speech API by default. For external Whisper STT,
#      set a real OpenAI key (not the Google-aliased OPENAI_API_KEY above).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gbg-neuro-3f7108911be8.json

# ── LLM Observability (Langfuse or Phoenix — pick one) ──────
# Langfuse (preferred): pip install medexpert[langfuse]
# Sign up at cloud.langfuse.com, create a project, get keys.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
#
# Arize Phoenix (alternative): pip install medexpert[tracing]
# Sign up at app.phoenix.arize.com and get an API key.
# PHOENIX_API_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_PROJECT_NAME=medexpert

# ── Society Scraper Discovery (optional) ─────────────────────
# SOCIETY_ASCO_API_URL=
# SOCIETY_AHA_API_URL=
# SOCIETY_WHO_API_URL=
