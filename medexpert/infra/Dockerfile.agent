FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

# Install SAM + medexpert
COPY pyproject.toml .
COPY src/ src/
COPY configs/ configs/
COPY prompts/ prompts/

RUN pip install --no-cache-dir -e .

# Agent config is passed via SAM_CONFIG_FILE env var
ENV SAM_CONFIG_FILE=configs/agents/orchestrator.yaml

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

RUN groupadd -r medexpert && useradd -r -g medexpert medexpert
USER medexpert

ENTRYPOINT ["sam", "run", "--config"]
CMD ["configs/agents/orchestrator.yaml"]
