# MedExpert-v2: Multi-model Cloud Run single-container deployment
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt-dev redis-server ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install SAM from PyPI (clean, no build hook)
RUN pip install --no-cache-dir "solace-agent-mesh==1.16.4"

# Install medexpert
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .

# Memgraph MCP server (streamable-http transport, connects to Memgraph sidecar)
RUN pip install --no-cache-dir mcp-memgraph

# Override litellm for Pro (gemini-3.1-pro-preview) and Opus (claude-opus-4-6) models.
# SAM pins litellm==1.76.3 which predates these models. The override installs 1.82.0
# without re-resolving SAM's dependency tree (--force-reinstall --no-deps).
# Verified: gemini-2.5-flash works correctly under 1.82.0 (backward compatible).
RUN pip install --force-reinstall --no-deps "litellm>=1.82.0,<2.0.0"

# Override google-adk for Gemini 3.x thought_signature support.
# SAM 1.16.4 pins google-adk==1.18.0 which predates thought_signature handling.
# Gemini 3.x models (gemini-3.1-pro-preview) require thought_signatures in multi-turn
# tool calls — without them, the model returns 400 BadRequest after multiple tool uses.
# ADK 1.23.0+ preserves thought_signatures in FunctionCall conversions.
# See: https://github.com/google/adk-python/issues/3705
RUN pip install --force-reinstall --no-deps "google-adk>=1.23.0,<2.0.0"

# Cold store data directory
RUN mkdir -p /app/data

# Runtime files — all 3 config sets (standard + pro + opus)
COPY configs/ configs/
COPY prompts/ prompts/
COPY infra/start_v2.sh /app/start_v2.sh
RUN chmod +x /app/start_v2.sh

# Replace SAM's default UI with MedExpert-branded frontend (model selector, DR2 sorting, etc.).
# Must delete first — SAM's hashed filenames differ from ours, so COPY alone leaves stale files
# and index.html still references the old bundle.
RUN rm -rf /usr/local/lib/python3.12/site-packages/solace_agent_mesh/client/webui/frontend/static/
COPY frontend-static/ /usr/local/lib/python3.12/site-packages/solace_agent_mesh/client/webui/frontend/static/

# Override SAM gateway files with MedExpert customizations (graph_api router, evolution router, datasources health)
# These files are copied from our local repo by Cloud Build (not in SAM 1.16.4 pip package)
COPY gateway-overrides/main.py     /usr/local/lib/python3.12/site-packages/solace_agent_mesh/gateway/http_sse/main.py
COPY gateway-overrides/routers/agent_cards.py     /usr/local/lib/python3.12/site-packages/solace_agent_mesh/gateway/http_sse/routers/agent_cards.py

ENV PORT=8080
ENV SOLACE_DEV_MODE=true
# Ensure graph_api and other medexpert src/ packages are importable by the SAM gateway
ENV PYTHONPATH="/app/src:${PYTHONPATH}"
EXPOSE 8080
ENTRYPOINT ["/app/start_v2.sh"]
