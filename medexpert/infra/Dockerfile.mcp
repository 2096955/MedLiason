FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir -e .

# MCP server module is passed via MCP_SERVER env var
ENV MCP_SERVER=pubmed

EXPOSE 9001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${MCP_PORT:-9001}/health')" || exit 1

RUN groupadd -r medexpert && useradd -r -g medexpert medexpert
USER medexpert

ENTRYPOINT ["python", "-m"]
CMD ["mcp_servers.pubmed.server"]
