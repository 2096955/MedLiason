FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt-dev redis-server ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install SAM from PyPI (clean, no build hook)
RUN pip install --no-cache-dir "solace-agent-mesh==1.16.4"

# Upgrade litellm for Gemini 3.x thought_signature support.
# SAM pins litellm==1.76.3 which lacks thought_signature handling
# required by gemini-3.1-pro-preview (400 BadRequest on multi-turn tool calls).
# litellm>=1.82.0 auto-extracts and preserves thought_signatures.
RUN pip install --no-cache-dir "litellm>=1.82.0,<2.0"

# Install medexpert
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir -e .

# Memgraph MCP server (streamable-http transport, connects to Memgraph sidecar)
RUN pip install --no-cache-dir mcp-memgraph

# Cold store data directory (ephemeral on Cloud Run — lost on restart.
# Learning loops reset to defaults after each container restart.)
RUN mkdir -p /app/data

# Runtime files
COPY configs/ configs/
COPY prompts/ prompts/
# NOTE: Do NOT copy .env — it sets FASTAPI_HOST=localhost and FASTAPI_PORT=8000
# which conflicts with Cloud Run's PORT=8080. Use --system-env + Cloud Run env vars.
COPY infra/start_medliaison.sh /app/start_medliaison.sh
RUN chmod +x /app/start_medliaison.sh

# Overlay custom MedExpert-branded frontend over SAM's default Solace UI.
# SAM is installed from PyPI (non-editable), so __file__ in the gateway
# resolves to site-packages/. This COPY destination matches the gateway's
# StaticFiles mount path (main.py:464-467).
COPY frontend-static/ /usr/local/lib/python3.12/site-packages/solace_agent_mesh/client/webui/frontend/static/

# Patch: inject knowledgeGraph feature flag into the config endpoint response.
# SAM's Pydantic config model strips unknown keys from frontend_feature_enablement.
RUN python -c "\
f='/usr/local/lib/python3.12/site-packages/solace_agent_mesh/gateway/http_sse/routers/config.py'; \
t=open(f).read(); \
t=t.replace(\
  'feature_enablement = component.get_config(\"frontend_feature_enablement\", {})\n\n        identity_service_config',\
  'feature_enablement = component.get_config(\"frontend_feature_enablement\", {})\n        feature_enablement[\"knowledgeGraph\"] = True\n\n        identity_service_config'\
); \
open(f,'w').write(t)"

ENV PORT=8080
ENV SOLACE_DEV_MODE=true
EXPOSE 8080
ENTRYPOINT ["/app/start_medliaison.sh"]
