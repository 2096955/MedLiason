{
    "name": "@medexpert/mobile",
    "version": "1.0.0",
    "private": true,
    "description": "MedExpert native mobile wrapper (Capacitor 6)",
    "scripts": {
        "build:web": "cd ../client/webui/frontend && npm run build && cp -r static ../../../mobile/www",
        "cap:sync": "npx cap sync",
        "cap:sync:ios": "npx cap sync ios",
        "cap:sync:android": "npx cap sync android",
        "build:ios": "npm run build:web && npm run cap:sync:ios",
        "build:android": "npm run build:web && npm run cap:sync:android",
        "open:ios": "npx cap open ios",
        "open:android": "npx cap open android",
        "dev:ios": "MEDEXPERT_SERVER_URL=http://localhost:8080 npx cap run ios --livereload --external",
        "dev:android": "MEDEXPERT_SERVER_URL=http://10.0.2.2:8080 npx cap run android --livereload --external",
        "assets:generate": "npx @capacitor/assets generate --iconBackgroundColor '#015B82' --splashBackgroundColor '#015B82'"
    },
    "dependencies": {
        "@capacitor/core": "^6.2.0",
        "@capacitor/app": "^6.0.0",
        "@capacitor/haptics": "^6.0.0",
        "@capacitor/keyboard": "^6.0.0",
        "@capacitor/network": "^6.0.0",
        "@capacitor/push-notifications": "^6.0.0",
        "@capacitor/status-bar": "^6.0.0"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.0",
        "@capacitor/cli": "^6.2.0",
        "typescript": "~5.8.3"
    }
}
